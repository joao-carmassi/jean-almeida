---
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { Separator } from '@/components/ui/separator';
import { Home } from 'lucide-react';
import { Cta12 } from '../cta12';
import AuthorBio from '@/components/blog/author-bio.astro';
import MedicalDisclaimer from '@/components/blog/medical-disclaimer.astro';
import RelatedPosts from '@/components/blog/related-posts.astro';
import { formatPostDate } from '@/utils/posts';

interface Props {
  title: string;
  slug: string;
  publishDate: string;
  updatedDate?: string;
}

const { title, slug, publishDate, updatedDate } = Astro.props;

const formattedUpdatedDate =
  updatedDate && updatedDate !== publishDate
    ? formatPostDate(updatedDate)
    : null;
---

<section class='py-12 md:py-24 pt-8 md:pt-12'>
  <div class='container mt-18'>
    <Breadcrumb>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink aria-label='Início' href='/'>
            <Home className='h-4 w-4' />
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href='/blog/'>Blog</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>
    <h1 class='mt-6 mb-6 font-bold text-4xl xl:text-5xl'>{title}</h1>
    <p class='text-sm text-muted-foreground'>
      Publicado em <time datetime={publishDate}>{formatPostDate(publishDate)}</time
      >{
        formattedUpdatedDate && (
          <>
            {' · '}Atualizado em{' '}
            <time datetime={updatedDate}>{formattedUpdatedDate}</time>
          </>
        )
      }
    </p>
    <Separator className='mt-6 mb-12' />
    <div class='prose dark:prose-invert max-w-none'>
      <slot />
    </div>
    <MedicalDisclaimer />
    <RelatedPosts slug={slug} />
    <AuthorBio />
    <Cta12 />
  </div>
</section>

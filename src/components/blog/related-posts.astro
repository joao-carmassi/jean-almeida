---
import { ArrowRight } from 'lucide-react';
import { getRelatedPosts } from '@/utils/posts';

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const relatedPosts = getRelatedPosts(slug);
---

{
  relatedPosts.length > 0 && (
    <section class='mt-16' aria-labelledby='leia-tambem'>
      <h2 id='leia-tambem' class='text-2xl font-bold md:text-3xl'>
        Leia também
      </h2>
      <ul class='mt-8 grid gap-6 md:grid-cols-3'>
        {relatedPosts.map((post) => (
          <li class='flex'>
            <article class='flex flex-col gap-3 rounded-4xl bg-card p-6 shadow-md ring-1 ring-foreground/5'>
              <h3 class='text-lg leading-snug font-semibold'>
                <a class='hover:underline' href={post.href}>
                  {post.title}
                </a>
              </h3>
              <p class='line-clamp-3 text-sm text-muted-foreground'>
                {post.description}
              </p>
              <a
                href={post.href}
                aria-label={`Ler mais sobre ${post.title}`}
                class='mt-auto inline-flex items-center text-sm font-medium text-primary hover:underline'
              >
                Ler mais
                <ArrowRight className='ml-2 size-4' />
              </a>
            </article>
          </li>
        ))}
      </ul>
    </section>
  )
}

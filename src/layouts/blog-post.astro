---
import Layout from '@/layouts/layout.astro';
import { getBasePath, getCanonicalUrl } from '@/utils/env';
import serialize from 'serialize-javascript';
import type {
  WithContext,
  BlogPosting,
  BreadcrumbList,
  FAQPage,
} from 'schema-dts';
import BlogpostLayout from '@/components/blog/blogpost-layout.astro';
import { author, authorPersonSchema } from '@/data/author';

export interface BlogPostFrontmatter {
  title: string;
  description: string;
  label: string;
  publishDate: string;
  /** Data da última revisão de conteúdo, no formato `YYYY-MM-DD`. */
  updatedDate?: string;
  /** Slug-based canonical path, e.g. "/blog/onde-comer-em-sao-bento" */
  slug: string;
  keywords?: string[];
  ogImage?: string;
  robots?: string;
  /** Optional FAQ items for FAQPage schema */
  faq?: Array<{ question: string; answer: string }>;
}

const { frontmatter } = Astro.props as { frontmatter: BlogPostFrontmatter };

const basePath = getBasePath();
const authorId = author.id;
const canonicalUrl = getCanonicalUrl(frontmatter.slug);
const ogImage = frontmatter.ogImage ?? `${basePath}/og-image.jpg`;

const blogPostingSchema: WithContext<BlogPosting> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  url: canonicalUrl,
  datePublished: frontmatter.publishDate,
  dateModified: frontmatter.updatedDate ?? frontmatter.publishDate,
  inLanguage: 'pt-BR',
  image: {
    '@type': 'ImageObject',
    url: ogImage,
  },
  author: authorPersonSchema,
  // Só o `author` traz o nó completo; aqui basta a referência ao mesmo `@id`.
  publisher: { '@id': authorId },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  keywords: frontmatter.keywords?.join(', '),
};

const breadcrumbSchema: WithContext<BreadcrumbList> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Início',
      item: getCanonicalUrl('/'),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: getCanonicalUrl('/blog'),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: frontmatter.title,
      item: canonicalUrl,
    },
  ],
};

const faqSchema: WithContext<FAQPage> | null =
  frontmatter.faq && frontmatter.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: frontmatter.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;
---

<Layout
  title={frontmatter.title}
  description={frontmatter.description}
  canonical={canonicalUrl}
  openGraph={{
    basic: {
      title: frontmatter.title,
      type: 'article',
      image: ogImage,
      url: canonicalUrl,
    },
    optional: {
      description: frontmatter.description,
      siteName: 'Dr. Jean Almeida — Psiquiatra em São Paulo',
      locale: 'pt_BR',
    },
    image: {
      alt: frontmatter.title,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: frontmatter.title,
    description: frontmatter.description,
    image: ogImage,
    imageAlt: frontmatter.title,
  }}
  extend={{
    meta: [
      // `meta keywords` não é emitida: o Google a ignora desde 2009. O campo
      // `keywords` do frontmatter continua sendo lido — ele alimenta o ranking
      // de posts relacionados em `src/utils/posts.ts`.
      ...(frontmatter.robots
        ? [{ name: 'robots', content: frontmatter.robots }]
        : []),
    ],
  }}
>
  <script
    is:inline
    type='application/ld+json'
    set:html={serialize(blogPostingSchema, { isJSON: true })}
    slot='head'
  />
  <script
    is:inline
    type='application/ld+json'
    set:html={serialize(breadcrumbSchema, { isJSON: true })}
    slot='head'
  />
  {
    faqSchema && (
      <script
        is:inline
        type='application/ld+json'
        set:html={serialize(faqSchema, { isJSON: true })}
        slot='head'
      />
    )
  }
  <main class='min-h-svh'>
    <BlogpostLayout
      title={frontmatter.title}
      slug={frontmatter.slug}
      publishDate={frontmatter.publishDate}
      updatedDate={frontmatter.updatedDate}
    >
      <slot />
    </BlogpostLayout>
  </main>
</Layout>
